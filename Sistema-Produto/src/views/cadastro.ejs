<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>LeanExpress - Cadastro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-sm" style="max-width: 420px; width: 100%;">
        <h3 class="text-center mb-1 fw-bold text-primary">📦 LeanExpress</h3>
        <p class="text-center text-muted small mb-3">Criar Novo Perfil</p>

        <% if (erro) { %>
            <div class="alert alert-danger p-2 small"><%= erro %></div>
        <% } %>

        <form action="/cadastrar" method="POST">
            <div class="mb-2">
                <label class="form-label small fw-semibold">Nome</label>
                <input type="text" name="nome" class="form-control" required>
            </div>
            <div class="mb-2">
                <label class="form-label small fw-semibold">E-mail</label>
                <input type="email" name="email" class="form-control" required>
            </div>
            <div class="mb-2">
                <label class="form-label small fw-semibold">Senha</label>
                <input type="password" name="senha" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Perfil</label>
                <select name="perfil" class="form-select">
                    <option value="comum">Usuário Comum (Apenas Leitura)</option>
                    <option value="admin">Administrador (Acesso Total)</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success w-100">Cadastrar</button>
            <div class="text-center mt-3">
                <a href="/login" class="small text-decoration-none">Voltar para o Login</a>
            </div>
        </form>
    </div>
</body>
</html>