<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>LeanExpress - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-sm" style="max-width: 400px; width: 100%;">
        <h3 class="text-center mb-1 fw-bold text-primary">📦 LeanExpress</h3>
        <p class="text-center text-muted small mb-3">Painel de Acesso</p>
        
        <% if (erro) { %>
            <div class="alert alert-danger p-2 small"><%= erro %></div>
        <% } %>
        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <div class="alert alert-success p-2 small"><%= sucesso %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label small fw-semibold">E-mail</label>
                <input type="email" name="email" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Senha</label>
                <input type="password" name="senha" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
            <div class="text-center mt-3">
                <a href="/cadastrar" class="small text-decoration-none">Criar uma conta</a>
            </div>
        </form>
    </div>
</body>
</html>