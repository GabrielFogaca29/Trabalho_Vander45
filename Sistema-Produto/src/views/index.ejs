<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LeanExpress - Gestão de Produtos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; color: #212529; }
        .card { border: none; border-radius: 12px; }
        .btn-primary { background-color: #0d6efd; border: none; }
        .btn-primary:hover { background-color: #0b5ed7; }
        .table th { font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; color: #6c757d; }
    </style>
</head>
<body>

    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/">
                📦 <span class="text-primary">Lean</span>Express
            </a>
            <span class="navbar-text text-light small">Painel Único de Cadastro e Estoque</span>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row g-4">
            
            <!-- Formulário (Cadastrar e Editar) -->
            <div class="col-lg-4">
                <div class="card shadow-sm p-4">
                    <h5 class="fw-bold mb-3 text-dark">
                        <%= produtoEdicao ? 'Editar Produto' : 'Novo Produto' %>
                    </h5>
                    <form action="<%= produtoEdicao ? '/atualizar/' + produtoEdicao.id : '/salvar' %>" method="POST">
                        
                        <div class="mb-3">
                            <label for="nome" class="form-label small fw-semibold text-secondary">Nome do Produto</label>
                            <input type="text" class="form-control" id="nome" name="nome" value="<%= produtoEdicao ? produtoEdicao.nome : '' %>" placeholder="Ex: Monitor Gamer" required>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="preco" class="form-label small fw-semibold text-secondary">Preço (R$)</label>
                                <input type="number" step="0.01" class="form-control" id="preco" name="preco" value="<%= produtoEdicao ? produtoEdicao.preco : '' %>" placeholder="0.00" required>
                            </div>
                            <div class="col-6">
                                <label for="quantidade" class="form-label small fw-semibold text-secondary">Estoque</label>
                                <input type="number" class="form-control" id="quantidade" name="quantidade" value="<%= produtoEdicao ? produtoEdicao.quantidade : '' %>" placeholder="0" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="descricao" class="form-label small fw-semibold text-secondary">Descrição</label>
                            <textarea class="form-control" id="descricao" name="descricao" rows="3" placeholder="Informações detalhadas do produto..."><%= produtoEdicao ? produtoEdicao.descricao : '' %></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                <%= produtoEdicao ? 'Salvar Alterações' : 'Cadastrar Produto' %>
                            </button>
                            <% if (produtoEdicao) { %>
                                <a href="/" class="btn btn-light py-2 text-secondary fw-semibold">Cancelar</a>
                            <% } %>
                        </div>

                    </form>
                </div>
            </div>

            <!-- Tabela de Produtos Cadastrados -->
            <div class="col-lg-8">
                <div class="card shadow-sm p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold m-0">Lista de Produtos</h5>
                        <span class="badge bg-secondary rounded-pill"><%= produtos ? produtos.length : 0 %> itens</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">ID</th>
                                    <th>Produto</th>
                                    <th>Preço</th>
                                    <th>Estoque</th>
                                    <th>Descrição</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (produtos && produtos.length > 0) { %>
                                    <% produtos.forEach(p => { %>
                                        <tr>
                                            <td class="text-muted small">#<%= p.id %></td>
                                            <td class="fw-semibold text-dark"><%= p.nome %></td>
                                            <td class="text-nowrap">R$ <%= parseFloat(p.preco).toFixed(2) %></td>
                                            <td>
                                                <span class="badge <%= p.quantidade > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %> rounded-pill px-2">
                                                    <%= p.quantidade %> un
                                                </span>
                                            </td>
                                            <td class="text-muted small"><%= p.descricao || '-' %></td>
                                            <td class="text-end text-nowrap">
                                                <a href="/editar/<%= p.id %>" class="btn btn-sm btn-light text-primary me-1">Editar</a>
                                                <a href="/deletar/<%= p.id %>" class="btn btn-sm btn-light text-danger" onclick="return confirm('Tem certeza que deseja excluir o produto <%= p.nome %>?')">Excluir</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-5">
                                            Nenhum produto cadastrado no momento. Preencha o formulário para adicionar.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>