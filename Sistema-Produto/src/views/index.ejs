<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>LeanExpress - Painel de Controle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">📦 LeanExpress</a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small">
                    <strong><%= usuario.nome %></strong> (<%= usuario.perfil %>)
                </span>
                <a href="/logout" class="btn btn-outline-light btn-sm">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <% if (usuario.perfil === 'admin') { %>
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white font-weight-bold">
                    <%= produtoEdicao ? 'Editar Produto' : 'Cadastrar Novo Produto' %>
                </div>
                <div class="card-body">
                    <form action="<%= produtoEdicao ? '/atualizar/' + produtoEdicao.id : '/salvar' %>" method="POST">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <input type="text" name="nome" class="form-control" placeholder="Nome" value="<%= produtoEdicao ? produtoEdicao.nome : '' %>" required>
                            </div>
                            <div class="col-md-3">
                                <input type="number" step="0.01" name="preco" class="form-control" placeholder="Preço" value="<%= produtoEdicao ? produtoEdicao.preco : '' %>" required>
                            </div>
                            <div class="col-md-3">
                                <input type="number" name="quantidade" class="form-control" placeholder="Quantidade" value="<%= produtoEdicao ? produtoEdicao.quantidade : '' %>" required>
                            </div>
                            <div class="col-md-12">
                                <textarea name="descricao" class="form-control" placeholder="Descrição"><%= produtoEdicao ? produtoEdicao.descricao : '' %></textarea>
                            </div>
                            <div class="col-md-12">
                                <button type="submit" class="btn <%= produtoEdicao ? 'btn-warning' : 'btn-success' %>">
                                    <%= produtoEdicao ? 'Atualizar' : 'Salvar Produto' %>
                                </button>
                                <% if (produtoEdicao) { %>
                                    <a href="/" class="btn btn-secondary">Cancelar</a>
                                <% } %>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        <% } %>

        <div class="card shadow-sm">
            <div class="card-header bg-white font-weight-bold">Lista de Produtos</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Descrição</th>
                            <% if (usuario.perfil === 'admin') { %><th>Ações</th><% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(p => { %>
                            <tr>
                                <td><%= p.id %></td>
                                <td><%= p.nome %></td>
                                <td>R$ <%= p.preco %></td>
                                <td><%= p.quantidade %></td>
                                <td><%= p.descricao %></td>
                                <% if (usuario.perfil === 'admin') { %>
                                    <td>
                                        <a href="/editar/<%= p.id %>" class="btn btn-sm btn-warning">Editar</a>
                                        <a href="/deletar/<%= p.id %>" class="btn btn-sm btn-danger">Excluir</a>
                                    </td>
                                <% } %>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>